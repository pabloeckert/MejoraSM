# ═══════════════════════════════════════════
# MejoraSM — Variables de Entorno
# ═══════════════════════════════════════════
# Copiar este archivo como .env y completar:
#   cp .env.example .env
#
# NUNCA commitear el archivo .env real
# ═══════════════════════════════════════════

# ── Supabase ──────────────────────────────
# Obtener en: https://supabase.com/dashboard/project/TU_PROYECTO/settings/api
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu-anon-key-aqui

# ── Groq (Estratega + Creativo) ──────────
# Obtener en: https://console.groq.com/keys
# GRATIS — rate limit generoso
GROQ_API_KEY=gsk_tu_key_aqui

# ── DeepSeek (Crítico) ───────────────────
# Obtener en: https://platform.deepseek.com/api_keys
# GRATIS — créditos iniciales
DEEPSEEK_API_KEY=sk_tu_key_aqui

# ── Google Gemini (Backup) ───────────────
# Obtener en: https://aistudio.google.com/apikey
# GRATIS — 15 RPM en free tier
GEMINI_API_KEY=AI_tu_key_aqui

# ── HuggingFace (Embeddings RAG) ─────────
# Obtener en: https://huggingface.co/settings/tokens
# GRATIS — permiso "Read" suficiente
HF_API_KEY=hf_tu_key_aqui

# ── Supabase (solo para Edge Functions) ───
# Estas se configuran como secrets en Supabase Dashboard
# NO van en el .env local (solo las VITE_ son para el frontend)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Acceso admin al EDA ───────────────────
# No es variable de entorno: se gestiona insertando filas en la tabla
# app_admins (ver supabase/functions/_shared/auth.ts).

# ── Zernio (metrics-collector) ──
# Secret de Supabase (además del que ya existe en GitHub Actions para
# publicar — son dos secret stores distintos) — sin esto, metrics-collector
# responde un no-op limpio, no falla.
# ZERNIO_API_KEY=
